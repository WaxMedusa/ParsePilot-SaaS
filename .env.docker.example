# Copy to .env before `docker compose up --build`.
# Generate every secret with: openssl rand -hex 32
# Never commit the resulting .env.

APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=

# Supabase Auth (Google sign-in). Use the publishable/anon key only.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

POSTGRES_PASSWORD=replace-with-a-strong-database-password
SESSION_SECRET=replace-with-64-hex-characters
DOWNLOAD_SIGNING_SECRET=replace-with-64-hex-characters
INTERNAL_SERVICE_TOKEN=replace-with-64-hex-characters

S3_ACCESS_KEY_ID=parsepilot
S3_SECRET_ACCESS_KEY=replace-with-a-strong-minio-password
S3_BUCKET=parsepilot-documents
S3_REGION=us-east-1

MAX_UPLOAD_MB=10
LOG_LEVEL=info
PROCESSING_QUEUE=parsepilot

# Optional: AI extraction. Without a key the rules pipeline is used.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
PROCESSOR_AI_ENABLED=true

# Optional: Stripe test mode. Billing UI stays disabled without these.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=

# Ports exposed by compose
WEB_PORT=3000
PROCESSOR_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Transactional email (password reset, email verification, invitations)
# Use resend or postmark. Without a provider, development logs a one-time link.
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
