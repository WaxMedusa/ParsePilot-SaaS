# ---------------------------------------------------------------------------
# ParsePilot environment example. Copy to .env and fill in real values.
# Never commit .env. Never use production credentials in local development.
# ---------------------------------------------------------------------------

# Application
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public support address rendered in the UI (not a legal placeholder).
NEXT_PUBLIC_SUPPORT_EMAIL=

# Supabase Auth (Google sign-in). Use the project URL and publishable/anon key.
# Never put the service_role key in a web or mobile client.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PostgreSQL (authoritative business data)
DATABASE_URL=postgresql://parsepilot:parsepilot@localhost:5432/parsepilot?schema=public

# Queue. "database" uses the PostgreSQL job table and the polling worker.
# "redis" is the legacy RQ mode and additionally requires REDIS_URL.
QUEUE_DRIVER=database
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=parsepilot:jobs

# Secrets — generate with: openssl rand -hex 32
SESSION_SECRET=
DOWNLOAD_SIGNING_SECRET=
INTERNAL_SERVICE_TOKEN=
# Encrypts per-workspace AI provider keys saved in Settings → AI extraction.
SETTINGS_ENCRYPTION_KEY=

# Python processing service
PROCESSOR_URL=http://localhost:8000
PROCESSOR_TIMEOUT_MS=10000
# Used by the Python service to call the web internal API (Docker: http://web:3000)
WEB_INTERNAL_URL=http://localhost:3000
PROCESSING_QUEUE=parsepilot
PROCESSOR_JOB_TIMEOUT_SECONDS=900
PROCESSOR_EXPORT_TIMEOUT_SECONDS=300
PROCESSOR_SCHEDULER_INTERVAL_SECONDS=3600
PROCESSOR_RECONCILE_INTERVAL_SECONDS=300
PROCESSOR_POLL_INTERVAL_SECONDS=5

# Uploads
MAX_UPLOAD_MB=4
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,image/tiff,image/webp

# Storage: "local" (development only), "supabase" (private Supabase Storage), or "s3" (MinIO/S3).
# Prefer OBJECT_STORAGE_DRIVER on Vercel: Buildah reserves STORAGE_DRIVER.
OBJECT_STORAGE_DRIVER=local
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage-data
# Server-only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=parsepilot-documents
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=parsepilot-documents
S3_ACCESS_KEY_ID=parsepilot
S3_SECRET_ACCESS_KEY=parsepilot-local-secret
S3_FORCE_PATH_STYLE=true

# Stripe (test mode locally)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=

# Transactional email for password reset, email verification and team invitations.
# Use resend or postmark. Without a provider, development logs a one-time link.
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=

# AI / OCR providers used by the processing service.
# Without AI_API_KEY the deterministic rules pipeline is used. When enabled,
# the model fills gaps and reviews ambiguous party/identity fields; totals and
# dates remain rule-first and are checked by the validator.
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
# Small, low-cost default. Use a reasoning model such as o4-mini here if you
# want the model to spend more effort on difficult invoices.
AI_MODEL=gpt-4.1-mini
PROCESSOR_AI_ENABLED=true
PROCESSOR_AI_TIMEOUT_SECONDS=45
OCR_ENABLED=true
OCR_PROVIDER=tesseract
PROCESSOR_OCR_MAX_PAGES=40
PROCESSOR_MAX_PAGES=200
PROCESSOR_MAX_DOWNLOAD_MB=50

# Observability
LOG_LEVEL=info
METRICS_ENABLED=true

# Retention / regulatory configuration (days unless stated)
RETENTION_SOFT_DELETED_DOCUMENT_DAYS=30
RETENTION_EXPORT_DAYS=7
RETENTION_SESSION_DAYS=30
RETENTION_PASSWORD_RESET_MINUTES=60
RETENTION_EMAIL_VERIFICATION_MINUTES=1440
RETENTION_INVITATION_DAYS=7
RETENTION_SIGNED_URL_SECONDS=300
RETENTION_AUDIT_LOG_DAYS=730
RETENTION_DATA_REQUEST_ARTEFACT_DAYS=7
RETENTION_ACCOUNT_DELETION_GRACE_DAYS=30
RETENTION_SWEEP_INTERVAL_MINUTES=60
RETENTION_BACKUP_DAYS=30
RETENTION_STALLED_JOB_MINUTES=20

# Legal launch gate. Release CI must run: LEGAL_STRICT=1 npm run check:legal
LEGAL_STRICT=0
# unset/enforce blocks a production server while legal placeholders remain.
# "warn" is only for a non-public demonstration deployment.
LEGAL_GATE_MODE=
