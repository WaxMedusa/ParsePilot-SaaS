{
  "name": "parsepilot",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "test": "npm run test --workspace apps/web",
    "test:py": "python3 -m pytest services/processor/tests -q",
    "db:generate": "npm run db:generate --workspace apps/web",
    "db:migrate": "npm run db:migrate --workspace apps/web",
    "db:push": "npm run db:push --workspace apps/web",
    "db:seed": "npm run db:seed --workspace apps/web",
    "check:legal": "node scripts/check-legal-config.mjs",
    "check:design": "node scripts/check-design-constraints.mjs",
    "verify": "npm run check:design && npm run check:legal && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20.11"
  }
}
