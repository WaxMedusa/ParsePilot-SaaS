# syntax=docker/dockerfile:1
# Vercel Daemon image. The daemon root is services/processor, so this file uses
# paths relative to that directory. The existing Dockerfile remains for Compose.
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
  && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng libglib2.0-0 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app

RUN groupadd --system --gid 1001 processor \
  && useradd --system --uid 1001 --gid processor processor \
  && chown -R processor:processor /app
USER processor

CMD ["python", "-m", "app.daemon"]
