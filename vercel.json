{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    }
  },
  "daemons": {
    "worker": {
      "root": "services/processor",
      "entrypoint": "Dockerfile.vercel",
      "command": ["python", "-m", "app.daemon"],
      "instances": { "iad1": 1 },
      "resources": { "requests": { "memory": "1Gi" } },
      "terminationGracePeriodSeconds": 900,
      "bindings": [
        { "type": "service", "service": "web", "format": "url", "env": "WEB_INTERNAL_URL" }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
